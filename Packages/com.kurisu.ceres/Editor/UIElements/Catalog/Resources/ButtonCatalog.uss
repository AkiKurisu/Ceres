.ceres-catalog {
    position: absolute;
    padding: 32px;
    background-color: var(--ceres-bg-secondary);
    border-radius: var(--ceres-radius-panel);
}
.ceres-catalog-eyebrow, .ceres-catalog-description, .ceres-catalog-metric { color: var(--ceres-text-secondary); font-size: 12px; }
.ceres-catalog-title { font-size: 24px; -unity-font-style: bold; margin-top: 8px; }
.ceres-catalog-description { margin-top: 8px; white-space: normal; }
.ceres-catalog-scroll { flex-grow: 1; margin-top: 24px; }
.ceres-catalog-columns { flex-direction: row; flex-wrap: wrap; }
.ceres-catalog-column { flex-grow: 1; flex-basis: 0; min-width: 460px; margin-right: 24px; }
.ceres-catalog-section { margin-bottom: 32px; }
.ceres-catalog-heading { font-size: 16px; -unity-font-style: bold; }
.ceres-catalog-row { flex-direction: row; align-items: center; flex-wrap: wrap; margin-top: 12px; }
.ceres-catalog-row-label { width: 112px; min-width: 112px; color: var(--ceres-text-secondary); }
.ceres-catalog .ceres-action { margin-right: 8px; }
.ceres-catalog-constrained { width: 220px; }
.ceres-catalog-feedback { color: var(--ceres-text-secondary); font-size: 12px; white-space: normal; margin-top: 16px; }
